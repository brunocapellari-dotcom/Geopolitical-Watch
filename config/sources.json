{
  "source_quality_profiles": "config/source_quality.json",
  "history": {
    "default_lookback_hours": 24,
    "checkpoint_overlap_minutes": 30
  },
  "sources": [
    {
      "source_id": "gdelt_conflict_news",
      "kind": "gdelt",
      "enabled": true,
      "lookback_hours": 24,
      "maxrecords": 250,
      "query": "(war OR conflict OR airstrike OR missile OR shelling OR invasion OR \"drone strike\" OR ceasefire OR blockade)",
      "extension": "json"
    },
    {
      "source_id": "ucdp_ged_26_1",
      "kind": "ucdp",
      "enabled": false,
      "version": "26.1",
      "pagesize": 1000,
      "extension": "json"
    },
    {
      "source_id": "reliefweb_conflict_reports",
      "kind": "reliefweb",
      "enabled": false,
      "limit": 100,
      "query": "conflict war hostilities displacement",
      "extension": "json"
    },
    {
      "source_id": "nasa_firms_context",
      "kind": "firms",
      "enabled": false,
      "sensor": "VIIRS_SNPP_NRT",
      "area": "world",
      "day_range": 1,
      "extension": "csv"
    }
  ],
  "report": {
    "lookback_hours": 72,
    "min_priority": 0,
    "max_events": 20,
    "max_news_per_event": 5,
    "title_similarity_threshold": 0.78,
    "cluster_time_hours": 36,
    "cluster_distance_km": 250
  }
}